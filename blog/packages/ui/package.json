{
  "name": "@blog/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "scripts": {
    "prepare": "panda codegen && panda lib",
    "watch": "panda codegen && panda lib --watch",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1"
  },
  "devDependencies": {
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/vite": "2.5.0",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.7",
    "storybook-addon-vrt": "0.4.2"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.0.0",
    "react": "^19.3.1"
  }
}
