[
  {
    "label": "ブログ: 画像をアップロード",
    "command": "fnox",
    "args": [
      "-P",
      "blog-images",
      "--no-defaults",
      "exec",
      "--",
      "node",
      "apps/main/scripts/upload-image.ts",
      "$ZED_STEM"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/blog",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "ブログ: 記事をプレビュー",
    "command": "pnpm",
    "args": ["exec", "vp", "dev", "--open", "/posts/$ZED_STEM/"],
    "cwd": "$ZED_WORKTREE_ROOT/blog/apps/main",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "no_focus"
  }
]
